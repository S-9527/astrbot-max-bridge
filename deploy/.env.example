# QQ 助理的模型请求走 AstrBot 当前的 provider，桥在每次请求时替换成那个
# provider 的真实凭据。所以**这里没有模型密钥**——密钥只存在于 AstrBot
# 的 WebUI 配置（state/astrbot/cmd_config.json）里。
#
# 这个文件只需要 OmniRoute 的密钥（不用 OmniRoute 就整份删掉）。
# 生成方式（每个一行，全部独立随机）：
#
#   openssl rand -hex 32
#
# cp .env.example .env 后填入。所有值都是必填，没有可用默认值。

# ── OmniRoute 面板 ───────────────────────────────────────────────────
# 面板登录密码。
INITIAL_PASSWORD=

# ── OmniRoute 内部密钥 ────────────────────────────────────────────────
# 这些不是给你用的，是各个子系统之间互相签名的。泄露等于允许伪造会话。
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
OMNIROUTE_WS_BRIDGE_SECRET=
MACHINE_ID_SALT=

# ── 固定项，一般不用改 ────────────────────────────────────────────────
# 强制鉴权。改成 false 会让任何人都能消耗你的额度，不要。
REQUIRE_API_KEY=true
# 只监听本机。 AstrBot 容器通过 compose 内网访问，不受影响。
APP_BIND_HOST=127.0.0.1
DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132
OMNIROUTE_MEMORY_MB=8192
CONTAINER_MEMORY=10g
NODE_ENV=production
AUTH_COOKIE_SECURE=false
DISABLE_SQLITE_AUTO_BACKUP=false